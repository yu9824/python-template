{
  "name": "python-template",
  "dockerComposeFile": "../docker/docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/python-template",
  "remoteUser": "vscode",
  "postCreateCommand": "mamba env create -f environment.yml || mamba env update --name project-env -f environment.yml",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/project-env/bin/python"
      }
    }
  }
}
