// https: //code.visualstudio.com/remote/advancedcontainers/sharing-git-credentials
{
  "name": "python-template",
  "dockerComposeFile": "../docker/docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/python-template",
  "remoteUser": "vscode",
  "postCreateCommand": "mamba env create -y -f environment.yml && mamba clean -yaf",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "anthropic.claude-code",
        "tamasfe.even-better-toml",
        "njpwerner.autodocstring",
        "janisdd.vscode-edit-csv",
        "github.vscode-github-actions",
        "ms-python.mypy-type-checker",
        "ionutvmi.path-autocomplete",
        "ryu1kn.partial-diff",
        "yzhang.markdown-all-in-one",
        "yzane.markdown-pdf",
        "bierner.markdown-mermaid",
        "TakumiI.markdowntable",
        "charliermarsh.ruff",
        "shardulm94.trailing-spaces",
        "mosapride.zenkaku",
        "Gruntfuggly.todo-tree",
        "GrapeCity.gc-excelviewer",
        "emeraldwalk.RunOnSave"
      ],
      "settings": {
        // conda 環境名は environment.yml / docker/Dockerfile の CONDA_ENV_NAME と揃える
        "python.defaultInterpreterPath": "/opt/conda/envs/work/bin/python",
        "python.condaPath": "/opt/conda/bin/conda",
        "python.terminal.activateEnvironment": true,
        "python.terminal.activateEnvInCurrentTerminal": true,
        "python-envs.defaultEnvManager": "ms-python.python:conda",
        "python-envs.defaultPackageManager": "ms-python.python:conda"
      }
    }
  }
}
